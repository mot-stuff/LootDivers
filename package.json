{
  "name": "rarpg",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-first RARPG technical foundation",
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "volta": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.persistence.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "node scripts/run-playwright.mjs --project=chromium",
    "test:component": "vitest run --config vitest.browser.config.ts",
    "test:browser": "npm run test:component && node scripts/run-playwright.mjs",
    "test:visual": "node scripts/run-playwright.mjs --project=chromium --grep deterministic",
    "budget": "node scripts/report-transfer-budget.mjs --root=play/index.html",
    "budget:world": "node scripts/report-world-budget.mjs",
    "budget:fixture": "node scripts/report-fixture-budget.mjs",
    "timing:navigation": "node scripts/report-spatial-navigation-timing.mts",
    "timing:fixture": "node scripts/run-fixture-timing.mjs",
    "world:compile": "node scripts/world.mts compile",
    "world:check": "node scripts/world.mts check",
    "content:validate": "node scripts/content.mts validate",
    "content:compile": "node scripts/content.mts compile",
    "content:check-determinism": "node scripts/content.mts check-determinism",
    "content:generate-schemas": "node scripts/content.mts generate-schemas",
    "content:check-schemas": "node scripts/content.mts check-schemas",
    "content:check": "npm run content:check-schemas && npm run content:validate && npm run content:check-determinism"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.13.3",
    "@vitest/browser-playwright": "5.0.0",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
