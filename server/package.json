{
  "name": "lootdivers-server",
  "version": "0.0.0",
  "private": true,
  "description": "Loot Divers accounts + character blob API (TASK-707, DEC-032)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "esbuild src/server.ts src/audit.ts src/ban.ts src/unban.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outdir=dist",
    "start": "node dist/server.js",
    "dev": "npm run build && node --enable-source-maps dist/server.js",
    "audit": "node dist/audit.js",
    "ban": "node dist/ban.js",
    "unban": "node dist/unban.js",
    "build:memory": "esbuild src/dev.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/dev.js",
    "dev:memory": "npm run build:memory && node --enable-source-maps dist/dev.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
