# Loot Divers API environment (TASK-707).
#
# PRODUCTION (droplet): this file's real counterpart lives OUTSIDE the
# checkout at /opt/lootdivers/.env (runbook Part B step 12) so deploys never
# touch it. docker-compose.yml reads it via --env-file and derives
# DATABASE_URL and cookie/CORS configuration from these two values.

# Postgres superuser password for the compose stack. Generate once:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The apex production domain, no scheme, no "www." (the exact domain string
# is still an owner input — Phase 8 kickoff §7.1). Everything domain-shaped
# derives from it: CORS allows https://<APP_DOMAIN> and
# https://www.<APP_DOMAIN>, Caddy serves https://api.<APP_DOMAIN>, and
# session cookies are Secure. Example: APP_DOMAIN=example.com
APP_DOMAIN=

# --- Local development (no Docker required) -------------------------------
# The API also runs directly against any Postgres:
#   DATABASE_URL=postgres://user:pass@localhost:5432/lootdivers npm run dev
# Without NODE_ENV=production, CORS allows the Vite dev/preview localhost
# origins and cookies are not marked Secure. APP_DOMAIN may stay unset.
