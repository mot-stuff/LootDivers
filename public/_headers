# Cloudflare Pages cache policy (TASK-706, DEC-032).
# NOTE: Pages concatenates duplicate headers from multiple matching rules
# (verified live), so these rules are deliberately non-overlapping. The
# ":file" placeholder matches exactly one path segment: it covers the
# hashed Vite build output directly under /assets/ without matching the
# unhashed art in /assets/branding/ and /assets/characters/.

# Hashed Vite build output (content hash in the filename): cache forever.
/assets/:file
  Cache-Control: public, max-age=31536000, immutable

# Unhashed art assets: filenames are stable but the bytes DO change when
# the owner updates art. Cache four hours, then revalidate (ETag 304s
# keep repeat loads cheap).
/assets/branding/*
  Cache-Control: public, max-age=14400, must-revalidate

/assets/characters/*
  Cache-Control: public, max-age=14400, must-revalidate

# The HTML shell must never be stale: it carries the hashed asset names.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
