{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rarpg.dev/schemas/content/v1/project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "kind": {
      "type": "string",
      "const": "project"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "kind",
    "id"
  ]
}
