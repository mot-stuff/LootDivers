{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rarpg.dev/schemas/content/v1/common.schema.json",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}:[a-z][a-z0-9_.-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "versionProperties": {
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "contentVersion": { "$ref": "#/$defs/version" }
      },
      "required": ["schemaVersion", "contentVersion"]
    }
  }
}
