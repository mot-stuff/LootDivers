{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rarpg.dev/schemas/content/v1/stat-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "kind": {
      "type": "string",
      "const": "stat-registry"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9._/-]*$"
          },
          "minimum": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          },
          "maximum": {
            "type": "number",
            "minimum": -1000000000,
            "maximum": 1000000000
          }
        },
        "required": [
          "id",
          "minimum",
          "maximum"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "contentVersion",
    "kind",
    "entries"
  ]
}
